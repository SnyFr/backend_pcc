            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Agil Feriski\",\n  \"email\": \"new_creator@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"creator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan user baru.\n- Role yang diizinkan: `creator`, `editor`, `admin`.\n- Jika email sudah terdaftar, mengembalikan error `400 Bad Request` ('Email already taken' - TC-01)."
          },
          "response": []
        },
        {
          "name": "Login User (Auto-save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var resData = pm.response.json();",
                  "    if (resData.data && resData.data.token) {",
                  "        pm.collectionVariables.set(\"token\", resData.data.token);",
                  "        console.log(\"Token JWT berhasil disimpan ke variable {{token}}\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agil@creator.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login ke sistem dengan email & password.\n*Test script otomatis menyimpan token ke collection variable `{{token}}`.*"
          },
          "response": []
        }
      ]
